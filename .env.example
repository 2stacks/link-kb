# Linkding API Configuration
LINKDING_URL=https://linkding.2stacks.net
LINKDING_API_KEY=your_api_key_here

# Embedding Service (any OpenAI-compatible /v1/embeddings endpoint)
EMBEDDING_URL=http://localhost:8080
EMBEDDING_MODEL=nomic-embed-text-v1.5
# Per-request timeout for embedding calls (seconds)
# EMBEDDING_TIMEOUT=120
# How long index/search will wait for a cold embedding endpoint (seconds)
# EMBEDDING_READY_TIMEOUT=300
# Probe interval for the cold-start wait (seconds)
# EMBEDDING_READY_INTERVAL=5
# Mid-run circuit breaker: after an embed failure, a fast no-retry liveness
# probe (this many seconds) attributes it. When the endpoint is down or not
# serving, links are fast-skipped; after EMBED_BREAKER_THRESHOLD consecutive
# bad probes the run waits for recovery and resumes, or aborts.
# EMBED_PROBE_TIMEOUT=10
# EMBED_BREAKER_THRESHOLD=3
# Retry backoff factor for the embedding session (exponential: factor * 2^n,
# seconds). Lower it if your host fails fast and you want failed links to
# fall through to the breaker sooner.
# EMBED_RETRY_BACKOFF=2

# Database
DB_PATH=/data/link-kb.db

# Indexing
INDEX_INTERVAL_HOURS=24

# Link health tracking (report-only; never writes to Linkding)
# 1 = on (default), 0 = off
# HEALTH_TRACKING=1
# Per-page fetch timeout for content/health fetches (seconds)
# FETCH_TIMEOUT=15
