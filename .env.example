# Linkding API Configuration
LINKDING_URL=https://linkding.2stacks.net
LINKDING_API_KEY=your_api_key_here

# Embedding Service (any OpenAI-compatible /v1/embeddings endpoint)
EMBEDDING_URL=http://localhost:8080
EMBEDDING_MODEL=nomic-embed-text-v1.5
# Per-request timeout for embedding calls (seconds)
# EMBEDDING_TIMEOUT=120
# How long index/search will wait for a cold embedding endpoint (seconds)
# EMBEDDING_READY_TIMEOUT=300

# Database
DB_PATH=/data/link-kb.db

# Indexing
INDEX_INTERVAL_HOURS=24

# Link health tracking (report-only; never writes to Linkding)
# 1 = on (default), 0 = off
# HEALTH_TRACKING=1
# Per-page fetch timeout for content/health fetches (seconds)
# FETCH_TIMEOUT=15
